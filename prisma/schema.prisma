// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum OrderCategory {
  DELIVERY
  INTRADAY
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?

  role   Role          @default(USER)
  status AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet        Wallet?
  orders        Order[]
  holdings      Holding[]
  refreshTokens RefreshToken[]
  positions  Position[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Wallet {
  id            String  @id @default(uuid())
  balance       Decimal @db.Decimal(18, 2)
  lockedBalance Decimal @default(0) @db.Decimal(18, 2)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Stock {
  id        String  @id @default(uuid())
  symbol    String  @unique  // NSE symbol e.g. "RELIANCE"
  yahooSymbol String @unique  // Yahoo Finance symbol e.g. "RELIANCE.NS"
  name      String
  exchange  String            // "NSE" or "BSE"
  sector    String?           // "Energy", "Banking" etc
  industry  String?
  marketCap Decimal? @db.Decimal(20, 2)
  isinCode  String?  @unique
  isActive  Boolean @default(true)

  orders       Order[]
  trades       Trade[]
  priceHistory PriceHistory[]
  holdings     Holding[]
  positions  Position[]
  createdAt    DateTime       @default(now())

  @@index([symbol])
  @@index([sector])
}

model Order {
  id      String @id @default(uuid())
  userId  String
  stockId String

  type      OrderType
  side      OrderSide
  price     Decimal?  @db.Decimal(18, 2)
  quantity  Int
  filledQty Int       @default(0)

  status OrderStatus @default(OPEN)

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  buyTrades  Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")

  category  OrderCategory @default(DELIVERY)

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([stockId, status])
}

model Trade {
  id String @id @default(uuid())

  buyOrderId  String
  sellOrderId String
  stockId     String

  price    Decimal @db.Decimal(18, 2)
  quantity Int

  buyOrder  Order @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])
  stock     Stock @relation(fields: [stockId], references: [id])

  createdAt DateTime @default(now())

  @@index([stockId])
}

model PriceHistory {
  id        String   @id @default(uuid())
  stockId   String

  // Live tick price
  price     Decimal  @db.Decimal(18, 2)

  // OHLCV for charting
  open      Decimal? @db.Decimal(18, 2)
  high      Decimal? @db.Decimal(18, 2)
  low       Decimal? @db.Decimal(18, 2)
  close     Decimal? @db.Decimal(18, 2)
  volume    BigInt?

  timestamp DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, timestamp])
}

model Holding {
  id        String  @id @default(uuid())
  userId    String
  stockId   String
  quantity  Int
  lockedQty Int     @default(0)
  avgPrice  Decimal @default(0) @db.Decimal(18, 2)  // weighted average buy price

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([userId, stockId])
  @@index([userId])
}


model Position {
  id           String   @id @default(uuid())
  userId       String
  stockId      String
  quantity     Int      // net open qty
  avgBuyPrice  Decimal  @default(0)
  avgSellPrice Decimal  @default(0)
  buyQty       Int      @default(0)
  sellQty      Int      @default(0)
  buyValue     Decimal  @default(0)
  sellValue    Decimal  @default(0)
  status       PositionStatus @default(OPEN)
  tradingDate  DateTime // the day this position belongs to
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([userId, stockId, tradingDate])
}

enum PositionStatus {
  OPEN
  CLOSED
  SQUARED_OFF
}